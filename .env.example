# =====================================================================
# LnkLokr — Vercel environment variables
# =====================================================================
# Set these in Vercel: Project → Settings → Environment Variables.
# Anything prefixed with VITE_ is exposed to the browser. Everything else
# is server-only and is read by the Vercel serverless functions in /api.
#
# IMPORTANT: variable names live in *this* Vercel project's namespace, so
# they don't collide with other projects (e.g. FridayCanvas) — but you
# should still point them at separate Supabase projects so user data,
# RLS, and storage buckets stay isolated between apps.
# =====================================================================

# --- Public (exposed to the browser; safe to put real values in Vercel) ---
VITE_SUPABASE_URL=https://your-lnklokr-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LnkLokr public URL for password-reset and OAuth redirects (required on Vercel).
# Must also be listed in Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_PUBLIC_SITE_URL=https://lnk-lokr-cursor.vercel.app

# Stripe publishable key. Used client-side if/when you load Stripe.js
# directly in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. Override where the legacy "Upgrade" link goes. Defaults to
# /api/stripe/create-checkout-session?tier=cloud-monthly on the same
# Vercel deployment. Set this to a hosted Stripe Payment Link if you
# want to bypass the API route entirely.
# VITE_PURCHASE_URL=https://buy.stripe.com/your-payment-link

# --- Server-only (NEVER prefix with VITE_; read by /api routes only) ----
# Stripe API keys.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret. Get this from
# Stripe Dashboard → Developers → Webhooks → Endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe Price IDs for each LnkLokr tier shown on the product page:
#   one-device    → $3.99   one-time
#   five-device   → $7.99   one-time
#   cloud-monthly → $4.99 / month
#   cloud-yearly  → $59.00 / year
# Create these in Stripe Dashboard → Products. Make sure One Device and
# the 5-Device Pack are "one-time" prices and the LokBx Cloud prices are
# "recurring" prices (monthly / yearly).
STRIPE_PRICE_ID_ONE_DEVICE=price_replace_me
STRIPE_PRICE_ID_FIVE_DEVICE=price_replace_me
STRIPE_PRICE_ID_CLOUD_MONTHLY=price_replace_me
STRIPE_PRICE_ID_CLOUD_YEARLY=price_replace_me

# Service role key for the Supabase project. Required by the webhook
# handler so it can flip is_premium on the users table after a successful
# checkout / subscription event.
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Public site URL used for Stripe success/cancel redirects. Vercel sets
# VERCEL_URL automatically on Preview/Production deploys, but you can set
# this explicitly to your custom domain.
PUBLIC_SITE_URL=https://your-app.vercel.app
